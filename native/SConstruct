#!/usr/bin/env python
# Builds the native height field into bin/.
#
# Setting up from a clean checkout, none of which is committed:
#
#     git clone --depth 1 https://github.com/godotengine/godot-cpp.git native/godot-cpp
#     scons platform=windows target=editor -j8
#
# godot-cpp's master now carries Godot 4.7's own `extension_api.json` — checked,
# not assumed: it hashes identically to what this machine's Godot writes out with
# `--dump-extension-api`. So the dump-and-point-at-it dance this file used to
# describe is no longer needed, and a plain build is correct. If a future Godot
# gets ahead of godot-cpp again, dump the API and pass
# `custom_api_file=<path>` on the scons command line; nothing here needs editing.
#
# SCons needs a Python, and the one on PATH may well be the Windows Store stub
# that answers every invocation with an advert. Blender ships a real one:
#
#     & "$blender_dir\python\bin\python.exe" -m venv <somewhere outside the repo>
#     & "<somewhere>\Scripts\python.exe" -m pip install scons

import os

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "../bin/libplanet_volcano2{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
