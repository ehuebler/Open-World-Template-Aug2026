[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[ext_resource type="Shader" path="res://shaders/vivid/vivid_clouds.gdshader" id="1_clouds"]

; The deck Planet raises inside the atmosphere. shell_radius and deck_thickness
; are written per instance — the first is the mesh's own radius and a second
; planet would want a different one, and the second has to agree with it —
; everything else here is the look and is shared.
;
; render_priority orders the three transparent shells around the planet, which
; cannot be left to Godot's own sort: it orders by the distance to each object's
; origin, and the sea's origin is the point of water under the viewer while the
; other two sit at the planet's centre — so from orbit the sea sorts nearest of
; the three and would be drawn over the clouds above it. Sea 0, clouds 1, air 2,
; which is bottom to top.

[resource]
resource_name = "PlanetClouds"
render_priority = 1
shader = ExtResource("1_clouds")
shader_parameter/shell_radius = 9450.0
shader_parameter/deck_thickness = 700.0
shader_parameter/march_steps = 18
shader_parameter/step_detail = 0.55
shader_parameter/step_growth = 1.18
shader_parameter/density_gain = 0.055
