[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://game/player/player.gd" id="1_player"]
[ext_resource type="PackedScene" path="res://blender_assets/player_character.glb" id="2_character"]
[ext_resource type="Script" path="res://game/player/reticle.gd" id="3_reticle"]
[ext_resource type="Theme" path="res://ui/themes/main_theme.tres" id="4_theme"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape_player"]
resource_local_to_scene = true
radius = 0.32
height = 1.45

[sub_resource type="SphereShape3D" id="SphereShape_arm"]
radius = 0.2

; The safe margin is forty times the engine's default. The planet is a concave
; triangle soup rebuilt under the feet as the level of detail changes, and a
; millimetre of slack is not enough for the solver to push a capsule back out of
; a face it ended up inside — which reads as the body sinking into a hillside and
; sticking there. A few centimetres costs nothing and depenetrates in one frame.
[node name="Player" type="CharacterBody3D"]
floor_snap_length = 0.3
safe_margin = 0.04
max_slides = 6
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
position = Vector3(0, 0.725, 0)
shape = SubResource("CapsuleShape_player")

[node name="CeilingCheck" type="RayCast3D" parent="."]
position = Vector3(0, 0.2, 0)
target_position = Vector3(0, 1.3, 0)
collision_mask = 1
collide_with_areas = false

[node name="Character" parent="." instance=ExtResource("2_character")]

[node name="Head" type="Node3D" parent="."]
position = Vector3(0, 1.29, 0)

[node name="CameraArm" type="SpringArm3D" parent="Head"]
shape = SubResource("SphereShape_arm")
spring_length = 0.0
margin = 0.1

; Far enough to see the whole planet from the orbit players spawn in — a 4 km
; default clips it away entirely. Near is raised to match: the depth buffer has
; to span both ends of that range, and 0.05 m against 50 km z-fights the ground.
; Nothing is drawn inside 0.3 m anyway, which is where a held weapon is hidden.
[node name="Camera3D" type="Camera3D" parent="Head/CameraArm"]
near = 0.1
far = 50000.0

[node name="AimRay" type="RayCast3D" parent="Head/CameraArm/Camera3D"]
target_position = Vector3(0, 0, -100)
collision_mask = 1
collide_with_areas = false

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Reticle" type="Control" parent="HUD"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_reticle")

; Readable over anything the world puts behind it: each line of HUD text sits on
; its own drawn plate, and the plate is only as wide as the text. Light text with
; a dark shadow was the alternative, and it loses against a pale sky as surely as
; dark text loses against grass. The theme is set here so the plates find the
; empty PanelContainer stylebox the pencil surfaces are drawn in place of.
[node name="Prompts" type="Control" parent="HUD"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("4_theme")

[node name="TargetPlate" type="CenterContainer" parent="HUD/Prompts"]
visible = false
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 36.0
offset_bottom = 76.0
grow_horizontal = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="HUD/Prompts/TargetPlate"]
layout_mode = 2
mouse_filter = 2

; AuroraSurface.BLEED of every margin is spent on the gap between the panel edge
; and the drawn plate, so these are that much larger than the padding they look
; like: 20/15 here reads as 14/9 around the text.
[node name="Padding" type="MarginContainer" parent="HUD/Prompts/TargetPlate/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 15

[node name="TargetName" type="Label" parent="HUD/Prompts/TargetPlate/Panel/Padding"]
layout_mode = 2
theme_override_font_sizes/font_size = 23
horizontal_alignment = 1

