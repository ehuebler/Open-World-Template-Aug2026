[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[ext_resource type="Shader" path="res://shaders/vivid/vivid_surface.gdshader" id="1_surface"]

; The lander's hull. Everything it is painted with is a vertex colour — MeshMaker
; writes the whole scorched, rust-streaked look into the mesh and hands out no
; texture at all — so this reads COLOR and leaves base_color white rather than
; tinting over the top of it.
;
; texture_relief is off because there are no UVs on this mesh to read a texture
; along, and the two taps it costs would only ever sample the default white.
; The noise relief is on and is worth it here for the reason player_suit.tres
; explains it is not worth it on a character: this is an 18 m slab of flat-shaded
; metal, seen from far enough away that its own modelled detail stops carrying,
; and the noise is what stops it going to plastic at that range.
;
; The region wheel is turned down rather than off. A ship that came down from
; orbit is not made of the planet and should not swing through its hues, but a
; little of it is what stops the hull reading as pasted onto the photograph.
;
; And metallic is zero, which on a metal hull looks like a mistake and is not.
; The sky over this coast is magenta and it is most of the ambient light there
; is; a metallic surface has no diffuse albedo to speak of and reflects that sky
; almost neat, which turned the ship's greys and rust into one purple rock the
; moment it was in shadow. Specular carries the sheen instead, at a level that
; catches the sun without repainting the hull in the sky's colour.

[resource]
resource_name = "ColonyShipHull"
shader = ExtResource("1_surface")
shader_parameter/base_color = Color(1, 1, 1, 1)
shader_parameter/base_uv_scale = Vector2(1, 1)
shader_parameter/use_vertex_color = true
shader_parameter/saturation = 1.0
shader_parameter/brightness = 1.2
shader_parameter/roughness = 0.7
shader_parameter/metallic = 0.0
shader_parameter/specular = 0.28
shader_parameter/roughness_variation = 0.3
shader_parameter/texture_relief = 0.0
shader_parameter/relief_width = 1.5
shader_parameter/detail_scale = 2.6
shader_parameter/detail_amount = 0.12
shader_parameter/bump_scale = 7.0
shader_parameter/bump_strength = 0.16
shader_parameter/macro_scale = 0.28
shader_parameter/macro_amount = 0.16
shader_parameter/detail_near = 20.0
shader_parameter/detail_far = 90.0
shader_parameter/region_albedo = 0.07
shader_parameter/region_sheen = 0.16
shader_parameter/region_rim = 0.22
shader_parameter/emission_energy = 0.0
