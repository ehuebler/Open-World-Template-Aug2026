[gd_resource type="ShaderMaterial" load_steps=3 format=3]

[ext_resource type="Shader" path="res://shaders/vivid/vivid_surface.gdshader" id="1_surface"]
[ext_resource type="Texture2D" path="res://blender_assets/biome_paint/flower_tree_paint.png" id="2_paint"]

; The flower uses the same daylight surface as the trunk, plus local-night
; emission. vivid_surface derives night from this point's radial and the moving
; sun, so a tree begins glowing at its own sunset and goes out at its own dawn;
; no tree nodes or material parameters are updated by the cycle. PNG alpha is a
; semantic mask, not transparency: it selects the inner petals, painted veins,
; seed cup and anthers instead of making the entire crown a flat pink lamp.

[resource]
resource_name = "FlowerTreeHead"
shader = ExtResource("1_surface")
shader_parameter/base_color = Color(1, 1, 1, 1)
shader_parameter/base_texture = ExtResource("2_paint")
shader_parameter/base_uv_scale = Vector2(1, 1)
shader_parameter/use_vertex_color = false
shader_parameter/saturation = 1.18
shader_parameter/brightness = 1.1
shader_parameter/roughness = 0.72
shader_parameter/metallic = 0.0
shader_parameter/specular = 0.3
shader_parameter/roughness_variation = 0.2
shader_parameter/texture_relief = 0.5
shader_parameter/relief_width = 2.0
shader_parameter/detail_scale = 3.4
shader_parameter/detail_amount = 0.06
shader_parameter/bump_scale = 5.0
shader_parameter/bump_strength = 0.09
shader_parameter/macro_scale = 0.22
shader_parameter/macro_amount = 0.07
shader_parameter/detail_near = 18.0
shader_parameter/detail_far = 100.0
shader_parameter/region_albedo = 0.11
shader_parameter/region_sheen = 0.2
shader_parameter/region_rim = 0.28
shader_parameter/emission_energy = 0.0
shader_parameter/night_emission_color = Color(1, 0.035, 0.32, 1)
shader_parameter/night_emission_energy = 3.8
shader_parameter/night_emission_from_texture_alpha = true
; Each head receives its own phase and rate through MultiMesh custom data. The
; shallow amplitude reads as organic breathing rather than a synchronized sign.
shader_parameter/night_pulse_amount = 0.13
shader_parameter/night_pulse_speed = 0.22
shader_parameter/night_emission_albedo = 0.3
shader_parameter/distance_growth = true
shader_parameter/growth_full_within = 280.0
shader_parameter/growth_hidden_beyond = 360.0
