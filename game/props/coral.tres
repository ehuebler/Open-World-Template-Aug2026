[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[ext_resource type="Shader" path="res://shaders/vivid/vivid_plant.gdshader" id="1_plant"]

; Coral, on the same shader as the grass and the flowers.
;
; It is a plant as far as this project is concerned: something rooted to the
; ground that leans in a moving fluid, which is the one thing vivid_plant knows
; how to do without a bone or a script. What is different is the fluid. wind_sway
; is a third of the grass's and gust_length four times as long, which turns a
; breeze crossing a hillside in gusts into a swell moving a whole reef together,
; and rigidity is high because coral is limestone and only the branch tips give.
;
; underwater is the flag that puts it behind the same veil the sea bed is behind
; — see vivid_sea_veil. Without it a reef stays sharp and bright at a distance
; the ground under it has already faded out at, and reads as painted on.

[resource]
resource_name = "PlanetCoral"
shader = ExtResource("1_plant")
shader_parameter/base_color = Color(1, 1, 1, 1)
shader_parameter/saturation = 1.45
shader_parameter/brightness = 1.3
shader_parameter/tone_variation = 0.22
shader_parameter/roughness = 0.68
shader_parameter/specular = 0.28
shader_parameter/translucency = 0.34
shader_parameter/region_albedo = 0.06
shader_parameter/region_sheen = 0.35
shader_parameter/region_rim = 0.45
shader_parameter/rigidity = 3.2
shader_parameter/wind_sway = 4.5
shader_parameter/wind_speed = 0.32
shader_parameter/gust_length = 80.0
shader_parameter/push_sway = 9.0
shader_parameter/max_bend = 16.0
shader_parameter/purple_shift = 0.0
shader_parameter/custom_z_is_glow = false
shader_parameter/glow_strength = 0.0
shader_parameter/underwater = true
; Bioluminescence, and each head in its own colour.
;
; All four corals share this one material — the pink, blue, purple and green are
; vertex colour off four different meshes, and base_color above is white so that
; the mesh is what decides. So the glow cannot be authored as a colour here the
; way the flowers' dark purple and the trees' pink are: one colour written here
; would light the whole reef the same shade and lose the thing worth looking at.
;
; Instead the emission is taken from the coral itself. night_emission_albedo at
; 1.0 makes the mix in vivid_plant resolve to the plant's own albedo, and
; night_emission_color stays white so it scales that rather than tinting it. A
; pink head glows pink and a green one green with nothing per-species written
; down, and any fifth coral added later inherits the behaviour by existing.
;
; Energy is well under the flowers' 4.0 because that 4.0 is multiplied by a
; near-black emission colour, whereas this multiplies a lit coral — and because
; a reef at midnight is the darkest place on the planet, so there is nothing for
; it to compete with.
shader_parameter/night_emission_petals_only = false
shader_parameter/night_emission_color = Color(1, 1, 1, 1)
shader_parameter/night_emission_energy = 1.5
shader_parameter/night_emission_albedo = 1.0
; Slower and deeper than the flowers', which breathe at 0.27. A reef reads as
; one organism moving together at a distance, and the phase is hashed per plant
; from its rooted position in vivid_plant, so neighbouring heads are never in
; step however slow the rate is.
shader_parameter/night_pulse_amount = 0.18
shader_parameter/night_pulse_speed = 0.16
