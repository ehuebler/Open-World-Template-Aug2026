[ext_resource type="Shader" path="res://shaders/vivid/vivid_tech.gdshader" id="1_tech"]

; The formations are reflective through Godot's real specular response, not a
; custom light function. A small emissive thin-film term keeps the magenta /
; turquoise shift visible at night and at grazing angles without flattening the
; hundreds of authored panel shadows.

[resource]
resource_name = "AlienTechFormation"
shader = ExtResource("1_tech")
shader_parameter/deep_color = Color(0.045, 0.012, 0.09, 1)
