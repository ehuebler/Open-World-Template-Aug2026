[node name="Sun" type="DirectionalLight3D" parent="." unique_id=1310562230]
; The same sun, in the other hemisphere's summer. It was 17.3 degrees south of
; the equator, and the pole's horizon *is* the equatorial plane, so the arctic sat
; in permanent polar night: a black disc from orbit and a blue dusk on the ground,
; however white PlanetShape painted it. Mirrored rather than raised, so the sun is
; exactly as high as the rest of the world was lit and tuned under — only its
; declination changed sign. `dev/_arctic_test.gd` reports the angle.
;
; Godot writes a Transform3D's basis as **rows**, so the declination is the third
; number of the second triple and not of the third. Two attempts at this went the
; wrong way for want of knowing that.
transform = Transform3D(0.92202, -0.11511, 0.3695, 0, 0.95466, 0.29744, -0.38701, -0.27425, 0.8803, 0, 0, 0)
light_color = Color(1, 0.96, 0.9, 1)
light_energy = 1.05
; How far the shadow lookup steps along the surface normal before reading the
; map, in texels of whichever cascade it lands in.
;
; The engine default of 2 is set for rooms and props. The smallest thing here is
; the player, and it is the one thing in the game narrower than a handful of
; shadow texels: a head is about a dozen of them across, so the depth the map
; holds for it is a coarse staircase, and wherever the body faces the sun
; obliquely it reads back as being behind its own recorded depth and shades
; itself in hard black patches — the crown under the hair, the gap between an
; arm and the ribs, the top of a boot. Flying is where it shows worst, because
; the field of view opens to 81 degrees and every cascade widens with it, and
; because the patches then crawl over the body as the camera moves.
;
; 4 is the smallest value that clears it: measured by flying past the ground and
; differencing consecutive frames over the body, which at 2 changes across whole
; limbs and at 4 only along the silhouette, matching a body that casts no shadow
; at all. Going further would start pulling contact shadows off their casters,
; and buys nothing.
shadow_normal_bias = 4.0
shadow_enabled = true
shadow_blur = 0.0
; Where the four cascades hand over, as fractions of the 150 m below. Pulling
; the first break in from the default 0.1 spends the nearest cascade on the 5 m
; around the camera rather than on 15 m, which is a third of the texel size over
; the player and is what lets the bias above stay as low as 4.
;
; The cost is a seam where one cascade meets the next, and at 5 m that seam
; lands about where a third-person camera is pointed, so they are blended.
directional_shadow_split_1 = 0.035
directional_shadow_split_2 = 0.12
directional_shadow_split_3 = 0.4
directional_shadow_blend_splits = true
directional_shadow_max_distance = 150.0

[node name="Planet" type="Node3D" parent="." unique_id=1088204411]
script = ExtResource("5_planet")
shape = SubResource("PlanetShape_world")
; Left unset, the planet publishes no sun_direction at all and every shader that
; wants a day/night term falls back to the value declared in project.godot —
; which is a static guess and had the declination above already reversed under
; it. What that bought was a game where the sea glinted, the clouds lit and the
; air's limb glowed on the hemisphere facing away from the light, while Godot's
; own shading of the ground got it right, so the two disagreed by a hemisphere.
; The harnesses never saw it because each of them assigns this itself.
sun = NodePath("../Sun")

